{
  "name": "apichain-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "generate:api": "openapi-typescript ./openapi.json -o src/api/client/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "bundle:report": "node scripts/bundle-report.mjs"
  },
  "apichainBackendContract": {
    "repo": "Apichain-Kenya/apichain-backend",
    "commit": "42d90eb082a1a2485d2e48046fb5f7a255abf9e2",
    "note": "openapi.json is vendored at this backend commit. Bumping it is an explicit, reviewed change: copy the new openapi.json, run npm run generate:api, commit both."
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "idb": "8.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "^1.56.0",
    "openapi-fetch": "^0.17.0",
    "qr-scanner": "1.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "uqr": "0.1.3",
    "workbox-expiration": "~7.4.1",
    "workbox-precaching": "~7.4.1",
    "workbox-routing": "~7.4.1",
    "workbox-strategies": "~7.4.1",
    "wouter": "~3.11.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "jsqr": "1.4.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "~1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "~7.4.1"
  }
}
